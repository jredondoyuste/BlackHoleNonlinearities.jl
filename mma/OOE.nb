     RowBox[{
      RowBox[{"r", " ", 
       RowBox[{"AsymptoticsInf\[Chi]", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           FractionBox["hcirc", 
            SuperscriptBox["r", "3"]], "/.", 
           RowBox[{"JS", "->", "ThreeJSymbol"}]}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"l1", "->", "3"}], ",", 
            RowBox[{"l2", "->", "2"}], ",", 
            RowBox[{"l", "->", "2"}]}], "}"}]}], "//.", "EoM"}], "]"}]}], "/.", 
      RowBox[{"JS", "->", "ThreeJSymbol"}]}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"l1", "->", "3"}], ",", 
       RowBox[{"l2", "->", "2"}], ",", 
       RowBox[{"l", "->", "2"}]}], "}"}]}], "//.", "\[Chi]Rule2"}], "//", 
   "Simplify"}], ";"}], "\[IndentingNewLine]", 
