Cell[TextData[{
 "I will begin by fixing zpQ[2, 2, -1] in such a way that the part quadratic \
in the linear master scalars does not contribute to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "+"], TraditionalForm]],ExpressionUUID->
  "e025efce-5a40-417b-8136-936ab92b53d6"],
 ".\nBefore doing that, let me show that this choice reflects on the source, \
because later we will look at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "circ"], TraditionalForm]],ExpressionUUID->
  "695d7fa5-1016-4bf9-a09e-ea752c44c52c"],
 " and our choice of zpQ will imply certain values for c[4,0] and c[2,0]. \
Indeed"
}], "Text",
 CellChangeTimes->{{3.993544350444948*^9, 3.99354451470088*^9}, {
  3.9935446382241488`*^9, 3.993544672998961*^9}, {3.993631793628241*^9, 
  3.9936318073300333`*^9}},ExpressionUUID->"65c00305-3f55-4ccb-b6d4-\
c8acf7190c9d"],

