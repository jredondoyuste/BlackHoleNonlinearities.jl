            RowBox[{
             RowBox[{"l", "+", 
              RowBox[{"1", "/", "2"}]}], ",", " ", 
             RowBox[{"\[Omega]", " ", "r"}]}], "]"}]}]}], "]"}]}]}], "//", 
      "Simplify"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"sol0", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"First", "@", 
        RowBox[{"DSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[CurlyPhi]", "''"}], "[", "r", "]"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"4", " ", 
                SuperscriptBox["\[Omega]", "2"]}], "-", " ", 
               FractionBox[
                RowBox[{"l", "*", 
                 RowBox[{"(", 
