      RowBox[{"M", "->", "0"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"srcflat", "=", 
     RowBox[{
      RowBox[{"FLATSPACE", " ", "/.", " ", 
       RowBox[{"\[Psi]1o", " ", "->", " ", 
        RowBox[{"Function", "[", 
         RowBox[{"r", ",", " ", 
          RowBox[{"A", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"\[Omega]", " ", "r"}], "]"}], " ", 
