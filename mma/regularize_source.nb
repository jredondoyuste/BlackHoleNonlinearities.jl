                SuperscriptBox["r", "2"]]}], ")"}], 
             RowBox[{"\[CurlyPhi]", "[", "r", "]"}]}]}], "==", "srcflat"}], 
          ",", " ", "\[CurlyPhi]", ",", " ", "r"}], "]"}]}], " ", "/.", " ", 
       RowBox[{
        RowBox[{"C", "[", "1", "]"}], "->", "0"}]}], " ", "/.", " ", 
