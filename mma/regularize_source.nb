Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ToJuliaFormat", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"cleanexpr", ",", "str"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"cleanexpr", "=", 
       RowBox[{"expr", "/.", " ", 
        RowBox[{"\[Pi]", "->", "pi"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"str", "=", 
       RowBox[{"ToString", "[", 
        RowBox[{"InputForm", "[", "cleanexpr", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"str", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"str", ",", " ", 
         RowBox[{"\"\<I\>\"", "->", "\"\<1im\>\""}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"str", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"str", ",", " ", 
         RowBox[{"\"\<Sqrt\>\"", "->", "\"\<sqrt\>\""}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"str", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"str", ",", " ", 
         RowBox[{"\"\<Log\>\"", "->", "\"\<log\>\""}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"str", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"str", ",", 
         RowBox[{
          RowBox[{
          "RegularExpression", "[", 
           "\"\<([a-zA-Z]+)\\\\[([^\\\\[\\\\]]+)\\\\]\>\"", "]"}], ":>", 
          "\"\<$1($2)\>\""}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "str", "]"}]}]}], "\[IndentingNewLine]", "]"}]}],
   ";"}]], "Input",
 CellLabel->
  "In[137]:=",ExpressionUUID->"59fbd428-2161-446d-93b5-c5278d129cbd"],

