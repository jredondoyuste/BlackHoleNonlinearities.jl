Cell[CellGroupData[{

Cell[TextData[{
 "This strategy of looking at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "-"], TraditionalForm]],ExpressionUUID->
  "50c3d92c-352e-4af9-8b98-ef4a45b4a17a"],
 " (or more generally those components that are zero in RW gauge) fixes \
everything in the diffeomorphism, except\nthe order that contributes a finite \
amount to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "-"], TraditionalForm]],ExpressionUUID->
  "4cf1c9ab-3a99-46cf-9672-227f456b4e74"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "+"], TraditionalForm]],ExpressionUUID->
  "091a1388-da88-40cd-8e20-894b9ad3c123"],
 ".  This leaves 1 unknown in the odd sector, and 3 unknowns in the even \
sector.\nThese 4 unknowns must be fixed by also taking ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "\[Mu]\[Nu]"], TraditionalForm]],ExpressionUUID->
  "1083d6b3-091a-454a-ba1d-3bf915cadba9"],
 " and the regulator of the master scalar into account"
}], "Subsection",
 CellChangeTimes->{{3.9918311450019083`*^9, 3.9918312671929207`*^9}, {
  3.991889406829431*^9, 
  3.991889436530418*^9}},ExpressionUUID->"66ea0491-44eb-4e8f-8bc0-\
47f1b4c1c23b"],

