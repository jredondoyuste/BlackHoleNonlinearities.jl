      RowBox[{"{", 
       RowBox[{"n", ",", 
        RowBox[{"-", "3"}], ",", "1"}], "}"}]}], "]"}], 
    RowBox[{"\[Psi]2le", "[", "r", "]"}]}], "+", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ztQ", "[", 
        RowBox[{"1", ",", "1", ",", "n"}], "]"}], 
       SuperscriptBox["r", "n"]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", 
        RowBox[{"-", "1"}], ",", "2"}], "}"}]}], "]"}], 
    RowBox[{"\[Psi]1l1e", "[", "r", "]"}], 
    RowBox[{"\[Psi]1l2e", "[", "r", "]"}]}], "+", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ztQ", "[", 
        RowBox[{"1", ",", "2", ",", "n"}], "]"}], 
       SuperscriptBox["r", "n"]}], ",", 
