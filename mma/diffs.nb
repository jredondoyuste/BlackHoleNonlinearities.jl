Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Zeta]t", "[", "r_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ztL", "[", "n", "]"}], 
