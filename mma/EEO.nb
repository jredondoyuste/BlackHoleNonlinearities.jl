Cell[TextData[{
 "I will begin by fixing zmQ[1, 1, -1] in such a way that the part quadratic \
in the linear master scalars does not contribute to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "+"], TraditionalForm]],ExpressionUUID->
  "51365a76-9ee0-4346-b5df-d16ae7fad952"],
 ".\nBefore doing that, let me show that this choice reflects on the source, \
because later we will look at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "circ"], TraditionalForm]],ExpressionUUID->
  "9a307d74-84fb-4076-9f6c-b99f7aee2823"],
 " and our choice of zpQ will imply certain values for c[1,0] and c[2,0]. \
Indeed"
}], "Text",
 CellChangeTimes->{{3.993544350444948*^9, 3.99354451470088*^9}, {
   3.9935446382241488`*^9, 3.993544672998961*^9}, {3.993625580738408*^9, 
